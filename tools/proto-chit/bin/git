#!/bin/sh

# Worktree-local tap-through shim. Never install or copy this onto a global PATH.
set -u

real_git=${PROTO_CHIT_REAL_GIT:-/usr/bin/git}
command_name=${1:-}

shim_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
state_dir=${PROTO_CHIT_STATE_DIR:-"$shim_dir/../state"}
wal_path="$state_dir/events.wal.ndjson"

# Runs the emitter with the caller's git argv after `--`, prefixed by whatever
# optional flags this invocation carries. Positional parameters set inside a
# function are its own, so the caller's git argv survives untouched for the WAL
# fallback and the real-git exec below.
#
# PROTO_CHIT_SYNC_EXCLUDES is a comma-separated list of workspace entry names;
# each becomes one `--sync-exclude NAME` pair. Set-but-empty becomes an explicit
# defaults-only declaration. Unset adds no declaration, so the emitter refuses
# and the ordinary WAL fallback records the intent without blocking real git.
run_emitter() {
  git_argv_count=$#

  if [ -n "${PROTO_CHIT_TRACE_FILE:-}" ]; then
    set -- "$@" --trace "$PROTO_CHIT_TRACE_FILE"
  fi

  if [ "${PROTO_CHIT_SYNC_EXCLUDES+x}" = x ]; then
    excludes=$PROTO_CHIT_SYNC_EXCLUDES
    scope_name_added=0

    while [ -n "$excludes" ]; do
      case "$excludes" in
        *,*)
          name=${excludes%%,*}
          excludes=${excludes#*,}
          ;;
        *)
          name=$excludes
          excludes=""
          ;;
      esac

      if [ -n "$name" ]; then
        set -- "$@" --sync-exclude "$name"
        scope_name_added=1
      fi
    done

    if [ "$scope_name_added" -eq 0 ]; then
      set -- "$@" --declare-empty-sync-excludes
    fi
  fi

  set -- "$@" --

  # Rotate the git argv, still at the front, around behind the flags and `--`.
  while [ "$git_argv_count" -gt 0 ]; do
    arg=$1
    shift
    set -- "$@" "$arg"
    git_argv_count=$((git_argv_count - 1))
  done

  "$emitter" --data-dir "$PROTO_CHIT_DATA_DIR" proto-chit emit \
    --repo "$PWD" --state-dir "$state_dir" \
    --event-log "$PROTO_CHIT_EVENT_LOG_UUID" --real-git "$real_git" \
    "$@"
}

case "$command_name" in
  commit|merge|pull|branch|checkout|switch|tag|worktree|rebase|reset|filter-branch|replace|update-ref|notes|bisect|reflog|stash|cherry-pick|revert)
    emitter=${PROTO_CHIT_COMMONPLACE:-}
    emit_status=127
    emit_confirmed=0
    emit_output=""

    if [ -n "$emitter" ] && [ -n "${PROTO_CHIT_DATA_DIR:-}" ] && [ -n "${PROTO_CHIT_EVENT_LOG_UUID:-}" ]; then
      emit_output="${TMPDIR:-/tmp}/proto-chit-emitter.$$"

      if ! (umask 077 && set -C && : >"$emit_output") 2>/dev/null; then
        emit_output=""
      fi

      if [ -n "$emit_output" ]; then
        trap 'rm -f "$emit_output"' 0
        run_emitter "$@" >"$emit_output" 2>&1
        emit_status=$?
        cat "$emit_output" >&2 || :

        if [ "$emit_status" -eq 0 ] &&
          grep -q '^proto-chit: tap fired ' "$emit_output" 2>/dev/null; then
          emit_confirmed=1
        fi

        rm -f "$emit_output" || :
        emit_output=""
        trap - 0
      else
        # Temp-file failure cannot block git. Keep the emitter loud, but fail
        # toward recording because positive persistence cannot be confirmed.
        run_emitter "$@" >&2
        emit_status=$?
      fi
    fi

    if [ "$emit_status" -ne 0 ]; then
      "$shim_dir/proto-chit-wal" "$PWD" "$state_dir" "emitter-exit-$emit_status" "$@" ||
        echo "proto-chit: WAL APPEND FAILED; git remains advisory" >&2
    elif [ "$emit_confirmed" -ne 1 ]; then
      "$shim_dir/proto-chit-wal" "$PWD" "$state_dir" "emitter-exit-0-unconfirmed" "$@" ||
        echo "proto-chit: WAL APPEND FAILED; git remains advisory" >&2
    fi
    ;;
esac

# Pending unsigned envelopes are invisible by default: a checkout with broken
# credentials keeps feeling healthy while landing nothing. So every invocation
# -- read verbs included -- reports a non-empty WAL once, loudly, on stderr.
# Nothing here may block or fail git: every step is guarded and falls through.
if [ -s "$wal_path" ]; then
  pending=$(grep -c '' "$wal_path" 2>/dev/null) || pending=""

  if [ -n "$pending" ]; then
    age="unknown"
    recorded=$(head -n 1 "$wal_path" 2>/dev/null |
      sed -n 's/.*"recorded-at":"\([^"]*\)".*/\1/p') || recorded=""

    if [ -n "$recorded" ]; then
      recorded_epoch=$(date -d "$recorded" +%s 2>/dev/null) || recorded_epoch=""
      now_epoch=$(date +%s 2>/dev/null) || now_epoch=""

      case "$recorded_epoch:$now_epoch" in
        *[!0-9:]* | *:*:* | :* | *:) ;;
        *)
          delta=$((now_epoch - recorded_epoch))
          if [ "$delta" -lt 0 ]; then
            delta=0
          fi
          if [ "$delta" -lt 60 ]; then
            age="${delta}s"
          elif [ "$delta" -lt 3600 ]; then
            age="$((delta / 60))m"
          elif [ "$delta" -lt 86400 ]; then
            age="$((delta / 3600))h"
          else
            age="$((delta / 86400))d"
          fi
          ;;
      esac
    fi

    echo "proto-chit: $pending pending unsigned envelopes, oldest $age" >&2
  fi
fi

exec "$real_git" "$@"
