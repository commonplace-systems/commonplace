defmodule Commonplace.MUD.EngineStand do
  @moduledoc "Doc-hosted `stand` verb (CX-wkau, MUD-as-documents Inc-1 / tranche 1). Hot-editable."

  alias Commonplace.MUD.World

  def run(_cmd, ctx) do
    World.broadcast_room(
      ctx.current_room_uuid,
      %{kind: :emote, who: ctx.player_name, text: "stands up."},
      except: [ctx.player_uuid]
    )

    {:reply, "You stand up."}
  end
end
