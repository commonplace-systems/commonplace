# Dependencies and build
/deps
/_build
/.fetch
erl_crash.dump
*.ez
*.beam

# elixir_make NIF build artifact (rebuilt from c_src/flock_nif.c every compile)
apps/commonplace/priv/*.so

# Generated on crash
crash.dump

# IDE
.elixir_ls/
.vscode/

# OS
.DS_Store
Thumbs.db

# Session state
.claude/last-session-id
.letta/
data/
tmp/

# Dolt database files (added by bd init)
.dolt/
*.db
.worktrees/

# CX-xwh4: Wallaby browser tests use portable Chrome fetched by
# bin/setup-browser. Binaries are large + version-pinned; don't commit.
apps/commonplace_web/priv/browser/
apps/commonplace_web/screenshots/

# Escript outputs — multi-MB binaries built by `mix escript.build`.
# apps/commonplace_cli/commonplace_cli is currently tracked (legacy
# from early CLI days); other apps' escripts are ignored to prevent
# accidental commits when `git add apps/<name>/` picks up the
# generated file (see CX-k320 fix-up commit c31031e).
apps/commonplace_mcp/commonplace_mcp

# CX-4vy8: live serve / CubDB data dirs are untracked-but-were-NOT-ignored, so a
# routine `git stash -u` (or `git clean`) could sweep a live 90MB world into a
# stash — this actually happened 2026-07-12 (a ~30min data-loss scare, recovered
# from stash@{0}^3). Ignoring them makes it impossible: `stash -u` skips ignored
# files (only `stash -a`/`clean -x` would still catch them). Matches at any depth
# (workspace/.commonplace, dogfood-mud/.commonplace, zone-mud/.commonplace, ...)
# plus the timestamped rollback snapshots (.commonplace.pre-*, .commonplace.fresh-*).
# No tracked files live under these paths. STILL: never `git stash -u`/`clean -x`
# in ~/commonplace while a serve is live.
.commonplace/
.commonplace.*
.commonplace-shadow/

# workspace/ is live runtime state, not source. Synced to a private repo via
# the commonplace/git bridge; tracking it in a PUBLIC repo is the habit that
# leaked a Telegram bot token from commonplace-rs on 2026-01-23. This repo
# tracked the same app directory and missed the credential only by luck.
workspace/

# Probe-script single-instance locks (bin/bd-divergence, bin/bd-invariants,
# bin/cp-verify-deploy, bin/tix-migrate, bin/tix-drift). Runtime artifacts of
# running a diagnostic, never content.
.*.lock
