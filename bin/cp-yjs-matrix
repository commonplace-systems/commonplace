#!/usr/bin/env bash
# Run the Yjs conformance suite once per pinned oracle. Stable failures block;
# preview-only failures are surfaced as findings so v14 warnings reach humans
# without overriding the stable compatibility ruling. Preview 14.0.0-16 was
# deliberately pinned as the newest registry-published v14 prerelease on
# 2026-08-08 because new-feature compatibility tracks the preview line.

set -uo pipefail

TEST_FILE="apps/yelixer/test/yelixer/diff_yjs_test.exs"
STABLE_OUT="$(mktemp -t cp-yjs-stable.XXXXXX)"
PREVIEW_OUT="$(mktemp -t cp-yjs-preview.XXXXXX)"
trap 'rm -f "$STABLE_OUT" "$PREVIEW_OUT"' EXIT

echo "Yjs matrix: running stable oracle (yjs 13.6.32)"
YJS_ORACLE=stable bin/cp-test-guard --min 11 --apps 1 -- \
  mix test "$TEST_FILE" --include diff_yjs >"$STABLE_OUT" 2>&1
STABLE_RC=$?
cat "$STABLE_OUT"

echo "Yjs matrix: running preview oracle (yjs 14.0.0-16)"
YJS_ORACLE=preview bin/cp-test-guard --min 11 --apps 1 -- \
  mix test "$TEST_FILE" --include diff_yjs >"$PREVIEW_OUT" 2>&1
PREVIEW_RC=$?
cat "$PREVIEW_OUT"

if [[ "$STABLE_RC" -ne 0 ]]; then
  echo "Yjs matrix: FAILURE — stable oracle failed (rc=${STABLE_RC}); stable compatibility is blocking." >&2
  [[ "$PREVIEW_RC" -ne 0 ]] && \
    echo "Yjs matrix: preview oracle also failed (rc=${PREVIEW_RC})." >&2
  exit "$STABLE_RC"
fi

# ⛔ "PREVIEW DISAGREED" AND "PREVIEW NEVER RAN" ARE DIFFERENT FACTS.
#
# jes's ruling makes a DISAGREEMENT non-blocking: stable wins, the finding
# reaches a human. It says nothing about an oracle that did not execute — and
# that case carries NO INFORMATION, so treating it as a finding is a vacuous
# green wearing a warning label. Worse, it is stable: if the preview install
# breaks permanently, every run emits FINDING and exits 0 forever, and the
# signal we built this matrix to produce decays into steady-state noise.
#
# ExUnit distinguishes them for us: a setup_all failure invalidates the tests
# ("N invalid") and cp-test-guard reports a run that selected nothing. Either
# means the oracle did not answer, which blocks.
if [[ "$PREVIEW_RC" -ne 0 ]] &&
   { grep -qE '[0-9]+ invalid' "$PREVIEW_OUT" ||
     grep -q 'no ExUnit summary line' "$PREVIEW_OUT"; }; then
  echo "::error title=Yjs preview oracle did not run::Preview 14.0.0-16 failed to EXECUTE (rc=${PREVIEW_RC}) — its tests were invalidated or never selected, so this run carries no preview information at all. That is not a compatibility finding and is not covered by the stable-wins ruling; it is missing coverage." >&2
  echo "Yjs matrix: BLOCKED — the preview oracle did not run; fix the oracle rather than reading this as a finding." >&2
  exit 1
fi

if [[ "$PREVIEW_RC" -ne 0 ]]; then
  echo "::warning title=Yjs preview compatibility finding::Stable 13.6.32 passed, but preview 14.0.0-16 failed (rc=${PREVIEW_RC}). Review the preview output; this disagreement is non-blocking under the stable-wins policy."
  echo "Yjs matrix: FINDING — stable passed, preview failed (rc=${PREVIEW_RC}); human review required."
  exit 0
fi

echo "Yjs matrix: PASS — stable and preview each passed 11-test conformance floors."
