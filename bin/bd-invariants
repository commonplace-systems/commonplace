#!/usr/bin/env bash
#
# bd-invariants — READ-ONLY standing audit of Commonplace.Bd.Invariants'
# resting-state checks against the live substrate ticket-DAG.
#
# WHY THIS EXISTS (CX-gvbf follow-up)
#
# The 2026-08-05 resting-state-invariants ruling: invariants are
# declared over RESTING STATE, checked by one engine at several
# moments, ALARM-ONLY first. `Commonplace.Bd.Invariants` had exactly
# one check (`closed_matches_pin/3`) and was called from NOWHERE. This
# script is the cheapest call site: a standing read-only audit that
# runs `Commonplace.Bd.Invariants.check_all/2` over every ticket in
# the live corpus and reports what it finds.
#
# This is a REPORT, not a gate. It never blocks anything and never
# writes anything. It exits non-zero ONLY when it could not measure —
# never as a judgment about how many violations were found.
#
# ⚠️ Never print a bare count without the per-hit shapes — a count
# alone is not actionable and false-zeros go unscrutinised. This
# script always prints per-invariant summaries AND the full detail of
# every violation found.
#
# RPC / connection mechanics mirror bin/bd-divergence exactly (read
# that script's header for the full story) — this script does not
# repeat the rationale, only the mechanism:
#
#   * connects READ-ONLY over BEAM distribution to the ALREADY-RUNNING
#     live serve, the same way the MCP escript does
#     (`apps/commonplace_mcp/lib/commonplace_mcp.ex`, `connect/1`);
#   * NEVER starts, stops, or writes to that node;
#   * REQUIRES `ERL_INETRC` (see `bin/erl_inetrc`'s header) — without
#     it, `Node.connect` silently returns false because `commonplace`
#     resolves to a real interface address the serve's loopback-only
#     dist listener doesn't answer on;
#   * takes a non-blocking flock on its own lockfile so a second
#     concurrent invocation fails fast instead of racing a probe node
#     against this one.
#
# Usage:
#   bin/bd-invariants
#
# Env overrides (for testing / operating against a different serve):
#   BD_INVARIANTS_NODE — serve node name (default commonplace_dev@commonplace)
#   BD_INVARIANTS_HOST — short hostname to statically map to 127.0.0.1
#                        in the probe's ERL_INETRC (default: derived
#                        from BD_INVARIANTS_NODE's host part)
#
# Exit codes:
#   0 — measured successfully (regardless of how many violations were found)
#   2 — could not read the substrate side (serve unreachable, root_uuid
#       missing, or the erpc call itself failed) — NEVER prints figures
#       computed from a failed read
#   3 — could not even acquire the one-probe-at-a-time lock

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

SERVE_NODE="${BD_INVARIANTS_NODE:-commonplace_dev@commonplace}"
SERVE_HOST="${BD_INVARIANTS_HOST:-${SERVE_NODE#*@}}"

LOCK_FILE="$PROJECT_DIR/.bd-invariants.lock"
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

# --- one-probe-at-a-time guard ---------------------------------------
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "bd-invariants: another bd-invariants (or probe) run holds the lock at $LOCK_FILE — refusing to start a second concurrent probe node." >&2
  exit 3
fi

PROBE_SCRIPT="$TMP_DIR/probe.exs"
INETRC="$TMP_DIR/inetrc"

cat >"$INETRC" <<EOF
{lookup, [file, native]}.
{host, {127,0,0,1}, ["$SERVE_HOST"]}.
EOF

cat >"$PROBE_SCRIPT" <<'ELIXIR'
[serve_node_str] = System.argv() |> Enum.reject(&(&1 == "--"))
serve_node = String.to_atom(serve_node_str)

# Same fix as bin/bd-divergence's probe (CX-y6uc): a short-lived probe
# node joining/leaving repeatedly can trip :global's overlapping-
# partition heuristic against the long-running serve. Must be set
# before Node.start.
:application.set_env(:kernel, :prevent_overlapping_partitions, false)
:application.set_env(:kernel, :inet_dist_use_interface, {127, 0, 0, 1})

probe_name =
  :"bd_invariants_probe_#{:erlang.unique_integer([:positive])}@#{System.get_env("BD_INVARIANTS_HOST", "commonplace")}"

fail = fn msg ->
  IO.puts(:stderr, "bd-invariants: could not read the substrate side — #{msg}")
  IO.puts(:stderr, "bd-invariants: refusing to report invariant figures computed from a failed substrate read.")
  System.halt(2)
end

case Node.start(probe_name, :shortnames) do
  {:ok, _} -> :ok
  {:error, reason} -> fail.("could not start local probe node (#{inspect(reason)})")
end

unless Node.connect(serve_node) do
  fail.("Node.connect(#{inspect(serve_node)}) returned false/failed — is the serve up? (pang)")
end

root =
  case :erpc.call(serve_node, Commonplace.Workspace, :root_uuid, [], 15_000) do
    {:ok, root} -> root
    other -> fail.("Commonplace.Workspace.root_uuid() on #{inspect(serve_node)} returned #{inspect(other)}")
  end

result =
  try do
    :erpc.call(
      serve_node,
      Commonplace.Bd.Invariants,
      :check_all,
      [root, Commonplace.Store.CommitStoreClient],
      60_000
    )
  catch
    :error, reason -> fail.("Commonplace.Bd.Invariants.check_all/2 erpc call raised #{inspect(reason)}")
    :exit, reason -> fail.("Commonplace.Bd.Invariants.check_all/2 erpc call exited #{inspect(reason)}")
  end

## Scope of the acyclic walk, printed BESIDE its verdict.
##
## "acyclic: ok" is not self-interpreting. A corpus with a rich needs
## graph and a corpus whose needs were all silently dropped by a bug
## both report "no cycles found" — one because there are none, the
## other because there was nothing to find. Without the edge count a
## future silent-empty would render as an identical clean line.
## Computed CLIENT-SIDE on purpose. The serve lazily loads modules from
## `_build` on first call, so an RPC to a function it has not loaded yet
## silently picks up whatever is on disk — while a function ADDED to an
## already-loaded module raises :undef until the serve restarts. Either
## way the audit's own freshness would depend on the serve's load
## history, which is not a property anyone can reason about. Fetching
## the issue list (long-deployed) and computing here removes that
## coupling entirely.
graph =
  serve_node
  |> :erpc.call(Commonplace.Bd.Issue, :list, [root, Commonplace.Store.CommitStoreClient], 120_000)
  |> Enum.map(fn {issue, _node_id} ->
    (issue.needs || [])
    |> Enum.filter(&(is_map(&1) and not Map.has_key?(&1, "repo")))
    |> Enum.count(&match?(%{"ticket" => t} when is_binary(t), &1))
  end)
  |> then(fn counts ->
    %{
      tickets: length(counts),
      local_edges: Enum.sum(counts),
      tickets_with_needs: Enum.count(counts, &(&1 > 0))
    }
  end)

IO.puts("""

bd-invariants report
=====================
substrate node : #{serve_node}
needs graph    : #{graph.tickets} tickets, #{graph.local_edges} local edges, \
#{graph.tickets_with_needs} tickets with >=1 local need
""")

if graph.local_edges == 0 do
  IO.puts(
    "⚠️  the needs graph has NO local edges — `acyclic: ok` below is vacuous, " <>
      "not evidence. Check whether needs are being written at all.\n"
  )
end

total_violations =
  result
  |> Map.values()
  |> Enum.map(fn %{violations: v} -> length(v) end)
  |> Enum.sum()

Enum.each(result, fn {invariant, %{checked: checked, ok: ok, violations: violations, errors: errors}} ->
  IO.puts(
    "#{invariant}: checked=#{checked} ok=#{ok} violations=#{length(violations)} errors=#{length(errors)}"
  )
end)

IO.puts("")

Enum.each(result, fn {invariant, %{violations: violations, errors: errors}} ->
  if violations != [] do
    IO.puts("#{invariant} — VIOLATIONS (#{length(violations)}):")

    Enum.each(violations, fn detail ->
      IO.puts("  #{inspect(detail)}")
    end)

    IO.puts("")
  end

  if errors != [] do
    IO.puts("#{invariant} — ERRORS (#{length(errors)}, not counted as violations):")

    Enum.each(errors, fn detail ->
      IO.puts("  #{inspect(detail)}")
    end)

    IO.puts("")
  end
end)

if total_violations == 0 do
  IO.puts("bd-invariants: measured successfully — NO violations found across #{map_size(result)} invariants.")
else
  IO.puts("bd-invariants: measured successfully — #{total_violations} total violation(s) found (see detail above). This is a REPORT, not a gate.")
end

System.halt(0)
ELIXIR

cd "$PROJECT_DIR"
BD_INVARIANTS_HOST="$SERVE_HOST" ERL_INETRC="$INETRC" mix run --no-start "$PROBE_SCRIPT" -- "$SERVE_NODE"
