#!/usr/bin/env bash
#
# check-cli-fresh — compare every project module bundled in the CLI escript
# with the current build.
#
# The CLI is a precompiled artifact. Source can contain a fix while an older
# copy of the same module remains bundled in the executable, so source state is
# not evidence that the executable is current.
#
# Contract (the same three outcomes as check-mcp-fresh):
#   0  every compared module matches and no built module is missing
#   1  stale: at least one module differs or is absent from the escript
#   2  cannot determine: artifact/build missing or unreadable, or zero coverage
#
# Usage:
#   bin/check-cli-fresh
#
# Test overrides leave the tracked artifact and build untouched:
#   CLI_CHECK_ESCRIPT=/path/to/escript bin/check-cli-fresh
#   CLI_CHECK_BUILD_DIR=/path/to/_build/dev/lib bin/check-cli-fresh

set -uo pipefail

name="check-cli-fresh"
script_dir="$(cd "$(dirname "$0")" && pwd)"
project_dir="$(dirname "$script_dir")"
escript="${CLI_CHECK_ESCRIPT:-$project_dir/apps/commonplace_cli/commonplace_cli}"
build="${CLI_CHECK_BUILD_DIR:-${MIX_BUILD_PATH:-$project_dir/_build/dev}/lib}"

cannot_verify() {
  echo "$name: CANNOT VERIFY — $1" >&2
  echo "$name: coverage: 0 modules compared" >&2
  exit 2
}

[[ -f "$escript" ]] || cannot_verify "no CLI escript at $escript"
[[ -r "$escript" ]] || cannot_verify "CLI escript is unreadable at $escript"
[[ -d "$build" ]] || cannot_verify "no build library directory at $build"
[[ -r "$build" ]] || cannot_verify "build library directory is unreadable at $build"

cd "$project_dir" || cannot_verify "cannot enter project directory at $project_dir"

elixir -e '
name = "check-cli-fresh"
[escript, build, project] = System.argv()

halt_cannot = fn detail, compared ->
  IO.puts(:stderr, "#{name}: CANNOT VERIFY — #{detail}")
  IO.puts(:stderr, "#{name}: coverage: #{compared} modules compared")
  System.halt(2)
end

md5_of = fn bin ->
  case :beam_lib.md5(bin) do
    {:ok, {_module, md5}} -> {:ok, md5}
    other -> {:error, inspect(other)}
  end
end

result =
  try do
    with {:ok, sections} <- :escript.extract(String.to_charlist(escript), []),
         {:ok, archive} <- Keyword.fetch(sections, :archive),
         {:ok, entries} <- :zip.extract(archive, [:memory]) do
      {:ok, entries}
    else
      error -> {:error, inspect(error)}
    end
  rescue
    error -> {:error, Exception.message(error)}
  catch
    kind, value -> {:error, "#{kind}: #{inspect(value)}"}
  end

entries =
  case result do
    {:ok, extracted} -> extracted
    {:error, detail} -> halt_cannot.("cannot read CLI escript archive (#{detail})", 0)
  end

beam_re = ~r{^([^/]+)/ebin/([^/]+)\.beam$}

escript_by_app =
  Enum.reduce(entries, %{}, fn {path, binary}, apps ->
    case Regex.run(beam_re, to_string(path)) do
      [_, app, module] -> Map.update(apps, app, %{module => binary}, &Map.put(&1, module, binary))
      nil -> apps
    end
  end)

project_apps =
  project
  |> Path.join("apps/*/mix.exs")
  |> Path.wildcard()
  |> Enum.map(fn mix_file -> mix_file |> Path.dirname() |> Path.basename() end)
  |> MapSet.new()

bundled_project_apps =
  escript_by_app
  |> Map.keys()
  |> Enum.filter(&MapSet.member?(project_apps, &1))
  |> Enum.sort()

if bundled_project_apps == [] do
  halt_cannot.("CLI escript contains no project apps, so freshness is underivable", 0)
end

missing_build_apps =
  Enum.reject(bundled_project_apps, fn app -> File.dir?(Path.join([build, app, "ebin"])) end)

if missing_build_apps != [] do
  halt_cannot.(
    "build is incomplete for #{length(missing_build_apps)} bundled project app(s): " <>
      Enum.join(missing_build_apps, ", "),
    0
  )
end

consolidated_dir = Path.join(Path.dirname(build), "consolidated")

reference_for = fn app, module ->
  consolidated = Path.join(consolidated_dir, "#{module}.beam")
  ordinary = Path.join([build, app, "ebin", "#{module}.beam"])

  cond do
    File.regular?(consolidated) -> {consolidated, File.read(consolidated)}
    File.regular?(ordinary) -> {ordinary, File.read(ordinary)}
    true -> {ordinary, {:error, :enoent}}
  end
end

compared =
  for app <- bundled_project_apps,
      {module, escript_binary} <- Map.fetch!(escript_by_app, app) do
    {reference_path, reference_read} = reference_for.(app, module)
    escript_md5 = md5_of.(escript_binary)

    build_md5 =
      case reference_read do
        {:ok, binary} -> md5_of.(binary)
        {:error, :enoent} -> :missing
        {:error, reason} -> {:error, inspect(reason)}
      end

    {app, module, escript_md5, build_md5, reference_path}
  end

n_modules = length(compared)
n_apps = length(bundled_project_apps)

if n_modules == 0 do
  halt_cannot.("CLI escript yielded zero comparable project modules", 0)
end

unreadable =
  Enum.filter(compared, fn {_app, _module, escript_md5, build_md5, _path} ->
    match?({:error, _}, escript_md5) or match?({:error, _}, build_md5)
  end)

if unreadable != [] do
  IO.puts(:stderr, "#{name}: CANNOT VERIFY — #{length(unreadable)} module(s) unreadable")

  Enum.each(unreadable, fn {app, module, escript_md5, build_md5, path} ->
    IO.puts(
      :stderr,
      "      #{app}/#{module} escript=#{inspect(escript_md5)} build=#{inspect(build_md5)} path=#{path}"
    )
  end)

  IO.puts(:stderr, "#{name}: coverage: #{n_modules} modules compared across #{n_apps} apps")
  System.halt(2)
end

changed =
  Enum.filter(compared, fn {_app, _module, escript_md5, build_md5, _path} ->
    escript_md5 != build_md5
  end)

missing_from_escript =
  for app <- bundled_project_apps,
      ebin = Path.join([build, app, "ebin"]),
      {:ok, files} = File.ls(ebin),
      file <- files,
      String.ends_with?(file, ".beam"),
      module = String.trim_trailing(file, ".beam"),
      not Map.has_key?(Map.fetch!(escript_by_app, app), module) do
    {app, module, Path.join(ebin, file)}
  end

reference_mtimes =
  compared
  |> Enum.map(fn {_app, _module, _escript_md5, _build_md5, path} -> path end)
  |> Kernel.++(Enum.map(missing_from_escript, fn {_app, _module, path} -> path end))
  |> Enum.uniq()
  |> Enum.flat_map(fn path ->
    case File.stat(path, time: :posix) do
      {:ok, stat} -> [stat.mtime]
      _ -> []
    end
  end)

artifact_mtime =
  case File.stat(escript, time: :posix) do
    {:ok, stat} -> stat.mtime
    {:error, reason} -> halt_cannot.("cannot stat CLI escript (#{inspect(reason)})", n_modules)
  end

newest_reference_mtime = Enum.max(reference_mtimes, fn -> nil end)

if is_nil(newest_reference_mtime) do
  halt_cannot.("no readable reference-module timestamps", n_modules)
end

delta_seconds = newest_reference_mtime - artifact_mtime

format_duration = fn total ->
  seconds = abs(total)
  days = div(seconds, 86_400)
  hours = seconds |> rem(86_400) |> div(3_600)
  minutes = seconds |> rem(3_600) |> div(60)
  secs = rem(seconds, 60)
  "#{days}d #{hours}h #{minutes}m #{secs}s (#{seconds} seconds)"
end

fmt_md5 = fn
  {:ok, md5} -> md5 |> Base.encode16(case: :lower) |> String.slice(0, 12)
  :missing -> "missing"
end

stale_count = length(changed) + length(missing_from_escript)

if stale_count == 0 do
  IO.puts(
    "#{name}: CLI escript is FRESH — #{n_modules} modules across #{n_apps} apps match the build"
  )

  IO.puts("#{name}: coverage: #{n_modules} modules compared; 0 stale; 0 missing from escript")
  System.halt(0)
else
  IO.puts(
    :stderr,
    "#{name}: CLI ESCRIPT IS STALE — #{stale_count} module(s) differ from the build " <>
      "(#{n_modules} compared across #{n_apps} apps; #{length(missing_from_escript)} missing from escript)"
  )

  age_relation = if delta_seconds >= 0, do: "older than", else: "newer than"

  IO.puts(
    :stderr,
    "#{name}: artifact mtime #{artifact_mtime}; newest compared build module mtime " <>
      "#{newest_reference_mtime}; artifact is #{format_duration.(delta_seconds)} #{age_relation} the build reference"
  )

  changed
  |> Enum.sort_by(fn {app, module, _escript_md5, _build_md5, _path} -> {app, module} end)
  |> Enum.each(fn {app, module, escript_md5, build_md5, _path} ->
    IO.puts(
      :stderr,
      "      #{app}/#{module} changed " <>
        "(escript=#{fmt_md5.(escript_md5)} build=#{fmt_md5.(build_md5)})"
    )
  end)

  missing_from_escript
  |> Enum.sort()
  |> Enum.each(fn {app, module, _path} ->
    IO.puts(:stderr, "      #{app}/#{module} missing from escript")
  end)

  IO.puts(:stderr, "#{name}: coverage: #{n_modules} modules compared; #{stale_count} stale")
  IO.puts(:stderr, "check-cli-fresh: rebuild with (cd apps/commonplace_cli && mix escript.build)")
  System.halt(1)
end
' "$escript" "$build" "$project_dir"

rc=$?
if [[ $rc -eq 0 || $rc -eq 1 || $rc -eq 2 ]]; then
  exit "$rc"
fi

echo "$name: CANNOT VERIFY — checker runtime exited unexpectedly with status $rc" >&2
echo "$name: coverage: 0 modules compared" >&2
exit 2
