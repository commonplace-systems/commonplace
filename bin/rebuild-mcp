#!/usr/bin/env bash
#
# rebuild-mcp — rebuild the commonplace MCP escript
#
# The commonplace MCP server ships as a precompiled escript at
# apps/commonplace_mcp/commonplace_mcp. Any time code under
# apps/commonplace_mcp/lib/ changes, that escript has to be rebuilt
# before a fresh stdio client will see the new code. There is no
# automatic hook — it's easy to forget and then waste time debugging
# a stale binary.
#
# Gotcha: `mix escript.build` must be run from the app directory, not
# the umbrella root. Running it from the root fails with
# "not an umbrella project". This wrapper cd's into the right place
# for you so you don't have to remember.
#
# Usage: just run `bin/rebuild-mcp` from anywhere.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR/apps/commonplace_mcp" && mix escript.build

echo "rebuilt escript at $PROJECT_DIR/apps/commonplace_mcp/commonplace_mcp"
