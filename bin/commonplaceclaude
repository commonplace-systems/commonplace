#!/usr/bin/env bash
# Launch a Claude Code session with commonplace MCP + clod-squad + claude-chat.
#
# Prerequisites:
#   1. commonplace serve (or equivalent named beam) running on the target
#      workspace — the .commonplace/node_name file must exist and point at
#      a reachable beam.
#   2. Built escripts: mix do --app commonplace_mcp escript.build
#
# Usage:
#   bin/commonplaceclaude [workspace_dir] [extra claude args...]
#
# If the first argument starts with a dash, it is treated as a claude flag
# and the workspace defaults to ${PROJECT_DIR}/workspace. Otherwise the
# first positional is taken as the workspace directory and shifted off.
# This lets you do e.g.:
#   bin/commonplaceclaude --resume <session-id>
#   bin/commonplaceclaude ./other-checkout --resume <session-id>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Treat the first arg as a workspace dir only if it is a non-empty, non-flag
# value. Otherwise leave all args intact for claude.
case "${1:-}" in
  -*|"")
    WORKSPACE="${PROJECT_DIR}/workspace"
    ;;
  *)
    WORKSPACE="$1"
    shift
    ;;
esac

if [ ! -d "${WORKSPACE}/.commonplace" ]; then
  echo "error: no .commonplace/ found at ${WORKSPACE}" >&2
  echo "hint: run 'commonplace init' there first, then 'commonplace serve'" >&2
  exit 1
fi

if [ ! -f "${WORKSPACE}/.commonplace/node_name" ]; then
  echo "error: no running 'commonplace serve' found at ${WORKSPACE}" >&2
  echo "hint: start serve first: cd ${WORKSPACE} && commonplace_cli serve &" >&2
  exit 1
fi

name="$(basename "${WORKSPACE}")"
config="${HOME}/.claude/channels/clod-squad/mcp-config-cp-${name}.json"

cat > "$config" <<MCPEOF
{
  "mcpServers": {
    "clod-squad": {
      "command": "bun",
      "args": ["run", "--cwd", "${HOME}/boss-clod/clod-squad", "--shell=bun", "--silent", "start"],
      "env": { "CLAUDE_PROJECT_DIR": "${WORKSPACE}" }
    },
    "claude-chat": {
      "command": "bun",
      "args": ["run", "--cwd", "${HOME}/claude-chat/irc-channel", "--shell=bun", "--silent", "start"],
      "env": { "CLAUDE_PROJECT_DIR": "${WORKSPACE}" }
    },
    "commonplace-mcp": {
      "command": "${PROJECT_DIR}/bin/commonplace-mcp",
      "env": { "COMMONPLACE_WORKSPACE": "${WORKSPACE}" }
    }
  }
}
MCPEOF

echo "MCP config: ${config}"
echo "Workspace:  ${WORKSPACE}"
echo "Serve node: $(cat "${WORKSPACE}/.commonplace/node_name")"
echo ""

cd "${WORKSPACE}"
exec claude --dangerously-skip-permissions \
     --mcp-config "$config" \
     --dangerously-load-development-channels server:clod-squad server:claude-chat \
     "$@"
