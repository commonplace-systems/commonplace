#!/usr/bin/env bash
#
# cp-verify-deploy — READ-ONLY deploy verification that reports LOAD STATE
# before it ever compares an md5, instead of the misleading opposite.
#
# WHY THIS EXISTS (CX-gq5o)
#
# The prior "zero skew" deploy-verification recipe compared
# `module_info(:md5)` local-vs-remote for the `commonplace` app's modules
# and called agreement proof the serve is running the deployed code. That
# check is ACTIVELY MISLEADING:
#
#   * The serve runs `mix phx.server` in :interactive code-loading mode,
#     with its code path pointed at the WORKING TREE's `_build/dev/lib`
#     (not a release snapshot). Modules load LAZILY, on first call.
#     Measured 2026-08-05: of the `commonplace` app's 249 modules, only
#     ~75 were actually loaded on the live serve; ~174 were not.
#   * `module_info/1` is a function OF the module it describes. Calling
#     `Mod.module_info(:md5)` on a module that is not yet loaded is a
#     remote call to that module — which FORCE-LOADS it, from whatever is
#     on disk in `_build` at that instant. So for an unloaded module the
#     old check (a) proves nothing about what the serve WAS running (it
#     wasn't running that module at all) and (b) pins the CURRENT disk
#     version into the serve as a side effect of the measurement itself.
#     It reports an agreement it just created, and structurally can never
#     report skew for an unloaded module — not because there is none, but
#     because the check erases the evidence as it looks.
#
# `:code.is_loaded/1` is the safe primitive: it reports load state without
# loading anything. This script uses ONLY that to partition modules, and
# only touches md5 for modules already confirmed loaded — see the probe
# script below for exactly which erlang primitive does the md5 fetch and
# why it was chosen over `module_info/1`.
#
# THIS IS A REPORT, NOT A GATE. It never blocks, never writes, and never
# claims more than it checked. A module that was never loaded is reported
# as NOT VERIFIED — never folded into an "agreement" count.
#
# SWEEPS EVERY UMBRELLA APP, not just `commonplace`. The app list is
# discovered dynamically from the `apps/` directory at run time — a new
# app added to the umbrella is covered automatically, no edit needed here.
# This was itself a bug: in two consecutive real deploys, changed modules
# in `commonplace_bots` (`Commonplace.Bots.NoteDoc`, `Commonplace.Bots.Agenda`)
# came back "NOT a module of the `commonplace` app" and had to be verified
# by a hand-rolled probe. A verification tool with a silent blind spot is
# worse than none. Some umbrella apps (e.g. a CLI escript app) legitimately
# never load in the serve at all — that is reported as NOT LOADED ON SERVE,
# not as a failure.
#
# ⚠️ A RELATED TRAP, worth recording next to this tool: `:erlang.function_
# exported/3` returns FALSE for a module that is not loaded, and does NOT
# force-load it. Probing a function that shipped in a PREVIOUS deploy can
# therefore report `false`, which reads as "the deploy failed" and actually
# means "not verified — this module was never loaded to begin with." Check
# `:code.is_loaded/1` FIRST. This tool reports load state before any verdict
# for exactly this reason.
#
# RPC / connection mechanics mirror bin/bd-divergence and bin/bd-invariants
# exactly (read either script's header for the full story) — this script
# does not repeat the rationale, only the mechanism:
#
#   * connects READ-ONLY over BEAM distribution to the ALREADY-RUNNING
#     live serve, the same way the MCP escript does
#     (`apps/commonplace_mcp/lib/commonplace_mcp.ex`, `connect/1`);
#   * NEVER starts, stops, or writes to that node;
#   * REQUIRES `ERL_INETRC` (see `bin/erl_inetrc`'s header) — without it,
#     `Node.connect` silently returns false because `commonplace` resolves
#     to a real interface address the serve's loopback-only dist listener
#     doesn't answer on;
#   * takes a non-blocking flock on its own lockfile so a second
#     concurrent invocation fails fast instead of racing a probe node
#     against this one (ONE PROBE NODE AT A TIME).
#
# Usage:
#   bin/cp-verify-deploy                          # full sweep, all modules
#   bin/cp-verify-deploy Commonplace.Bd.Issue ...  # also call out named modules
#
# Env overrides (for testing / operating against a different serve):
#   CP_VERIFY_DEPLOY_NODE — serve node name (default commonplace_dev@commonplace)
#   CP_VERIFY_DEPLOY_HOST — short hostname to statically map to 127.0.0.1
#                           in the probe's ERL_INETRC (default: derived
#                           from CP_VERIFY_DEPLOY_NODE's host part)
#
# Exit codes:
#   0 — measured successfully (regardless of load state or md5 findings —
#       this is a report, not a gate)
#   2 — could not read the substrate side (serve unreachable, module list
#       or load-state calls failed) — NEVER prints figures computed from
#       a failed read
#   3 — could not even acquire the one-probe-at-a-time lock

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

SERVE_NODE="${CP_VERIFY_DEPLOY_NODE:-commonplace_dev@commonplace}"
SERVE_HOST="${CP_VERIFY_DEPLOY_HOST:-${SERVE_NODE#*@}}"

# --- discover the umbrella app list from apps/, dynamically -----------
# Do NOT hardcode this list — a new app added to the umbrella must be
# swept automatically. Passed to the Elixir probe via an env var (not
# argv) because argv already carries the serve node plus any
# user-supplied named modules ("$@").
APPS_DIR="$PROJECT_DIR/apps"
UMBRELLA_APPS=""
for d in "$APPS_DIR"/*/; do
  app="$(basename "$d")"
  UMBRELLA_APPS="${UMBRELLA_APPS:+$UMBRELLA_APPS,}$app"
done

LOCK_FILE="$PROJECT_DIR/.cp-verify-deploy.lock"
TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

# --- one-probe-at-a-time guard ---------------------------------------
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "cp-verify-deploy: another cp-verify-deploy (or probe) run holds the lock at $LOCK_FILE — refusing to start a second concurrent probe node." >&2
  exit 3
fi

PROBE_SCRIPT="$TMP_DIR/probe.exs"
INETRC="$TMP_DIR/inetrc"

cat >"$INETRC" <<EOF
{lookup, [file, native]}.
{host, {127,0,0,1}, ["$SERVE_HOST"]}.
EOF

cat >"$PROBE_SCRIPT" <<'ELIXIR'
[serve_node_str | named_modules_str] =
  System.argv() |> Enum.reject(&(&1 == "--"))
serve_node = String.to_atom(serve_node_str)
named_modules = Enum.map(named_modules_str, &String.to_atom("Elixir." <> &1))

apps =
  System.get_env("CP_VERIFY_DEPLOY_APPS", "")
  |> String.split(",", trim: true)
  |> Enum.map(&String.to_atom/1)

# Same fix as bin/bd-divergence's probe (CX-y6uc): a short-lived probe
# node joining/leaving repeatedly can trip :global's overlapping-
# partition heuristic against the long-running serve. Must be set
# before Node.start.
:application.set_env(:kernel, :prevent_overlapping_partitions, false)
:application.set_env(:kernel, :inet_dist_use_interface, {127, 0, 0, 1})

probe_name =
  :"cp_verify_deploy_probe_#{:erlang.unique_integer([:positive])}@#{System.get_env("CP_VERIFY_DEPLOY_HOST", "commonplace")}"

fail = fn msg ->
  IO.puts(:stderr, "cp-verify-deploy: could not read the substrate side — #{msg}")
  IO.puts(:stderr, "cp-verify-deploy: refusing to report deploy-verification figures computed from a failed substrate read.")
  System.halt(2)
end

case Node.start(probe_name, :shortnames) do
  {:ok, _} -> :ok
  {:error, reason} -> fail.("could not start local probe node (#{inspect(reason)})")
end

unless Node.connect(serve_node) do
  fail.("Node.connect(#{inspect(serve_node)}) returned false/failed — is the serve up? (pang)")
end

# --- (1) enumerate every module of EVERY umbrella app, on the REMOTE -----
#
# The app list is discovered dynamically from `apps/` by the bash wrapper
# (never hardcoded here) and passed in via CP_VERIFY_DEPLOY_APPS. An app
# that returns :undefined is NOT loaded on the serve at all — that is
# expected for e.g. a CLI escript app and is reported, not failed.
app_modules =
  Enum.map(apps, fn app ->
    case :erpc.call(serve_node, :application, :get_key, [app, :modules], 15_000) do
      {:ok, mods} -> {app, :ok, mods}
      :undefined -> {app, :not_loaded_on_serve, []}
      other -> fail.(":application.get_key(#{inspect(app)}, :modules) on #{inspect(serve_node)} returned #{inspect(other)}")
    end
  end)

# --- (2) load state, via :code.is_loaded/1 ONLY -------------------------
#
# ⚠️ NEVER call `module_info/1`, `Code.ensure_loaded?/1`, `apply/3`, or
# anything else that invokes a function OF the module being measured —
# any of those force-load an unloaded module as a side effect, which is
# exactly the bug this tool exists to stop repeating (see header).
# `:code.is_loaded/1` is a code-server query, not a call into the module,
# so it reports state without changing it.
is_loaded? = fn mod ->
  case :erpc.call(serve_node, :code, :is_loaded, [mod], 15_000) do
    {:file, _path} -> true
    false -> false
    other -> fail.(":code.is_loaded(#{inspect(mod)}) on #{inspect(serve_node)} returned unexpected #{inspect(other)}")
  end
end

# --- (3) md5, LOADED modules only ----------------------------------------
#
# Remote md5, without force-loading: `:erlang.get_module_info/2` is a BIF
# that reads the code server's ALREADY-RESIDENT module record. Unlike
# `Mod.module_info/1` — which is a call to a function *of* Mod and so
# triggers the normal auto-load path if Mod isn't resident — this BIF
# does not dispatch through the module at all, so it can't force a load.
# It is only ever invoked here for modules `is_loaded?` already confirmed
# resident, so there is no load to trigger either way, but this is the
# form that stays safe even if that invariant were ever violated by a
# future edit to this script.
remote_md5 = fn mod ->
  try do
    case :erpc.call(serve_node, :erlang, :get_module_info, [mod, :md5], 15_000) do
      md5 when is_binary(md5) -> {:ok, md5}
      other -> {:error, other}
    end
  catch
    kind, reason -> {:error, {kind, reason}}
  end
end

# Local md5, from the beam file on disk — via :code.which/1 (locates the
# object file, does not load it) + :beam_lib.md5/1 (reads file bytes).
# Neither primitive loads the module into this probe process either.
local_md5 = fn mod ->
  case :code.which(mod) do
    path when is_list(path) ->
      case :beam_lib.md5(path) do
        {:ok, {_mod, md5}} -> {:ok, md5}
        other -> {:error, other}
      end

    other ->
      {:error, {:which_failed, other}}
  end
end

compare = fn mod ->
  with {:ok, r} <- remote_md5.(mod),
       {:ok, l} <- local_md5.(mod) do
    if r == l, do: {:match, mod}, else: {:diff, mod, l, r}
  else
    {:error, reason} -> {:compare_error, mod, reason}
  end
end

# --- per-app sweep: partition + compare, one app at a time ---------------
per_app =
  Enum.map(app_modules, fn
    {app, :not_loaded_on_serve, []} ->
      %{app: app, status: :not_loaded_on_serve}

    {app, :ok, mods} ->
      {loaded, not_loaded} = Enum.split_with(mods, is_loaded?)

      if length(loaded) + length(not_loaded) != length(mods) do
        fail.("partition size mismatch for app #{inspect(app)} — this should be impossible, refusing to report")
      end

      comparisons = Enum.map(loaded, compare)
      matches = Enum.count(comparisons, &match?({:match, _}, &1))
      diffs = Enum.filter(comparisons, &match?({:diff, _, _, _}, &1))
      compare_errors = Enum.filter(comparisons, &match?({:compare_error, _, _}, &1))

      %{
        app: app,
        status: :ok,
        modules: mods,
        loaded: loaded,
        not_loaded: not_loaded,
        matches: matches,
        diffs: diffs,
        compare_errors: compare_errors
      }
  end)

swept_apps = for %{app: app, status: :ok} <- per_app, do: app

# --- totals across all apps ------------------------------------------------
ok_apps = Enum.filter(per_app, &(&1.status == :ok))
total_modules = Enum.sum(Enum.map(ok_apps, &length(&1.modules)))
total_loaded = Enum.sum(Enum.map(ok_apps, &length(&1.loaded)))
total_not_loaded = Enum.sum(Enum.map(ok_apps, &length(&1.not_loaded)))
total_matches = Enum.sum(Enum.map(ok_apps, & &1.matches))
total_diffs = Enum.sum(Enum.map(ok_apps, &length(&1.diffs)))
total_compare_errors = Enum.sum(Enum.map(ok_apps, &length(&1.compare_errors)))

if total_loaded + total_not_loaded != total_modules do
  fail.("partition size mismatch across apps — this should be impossible, refusing to report")
end

# --- report ---------------------------------------------------------------

IO.puts("""

cp-verify-deploy report
========================
substrate node   : #{serve_node}
apps swept       : #{length(ok_apps)} (of #{length(apps)} discovered)
""")

IO.puts("  app                total   LOADED   NOT LOADED   md5 match   md5 DIFF   cmp err")

Enum.each(per_app, fn
  %{status: :not_loaded_on_serve, app: app} ->
    IO.puts(
      "  " <>
        String.pad_trailing(to_string(app), 19) <>
        String.pad_leading("-", 7) <>
        String.pad_leading("-", 9) <>
        String.pad_leading("-", 13) <>
        String.pad_leading("-", 12) <>
        String.pad_leading("-", 11) <>
        String.pad_leading("-", 10) <>
        "   (NOT LOADED ON SERVE)"
    )

  %{status: :ok} = a ->
    IO.puts(
      "  " <>
        String.pad_trailing(to_string(a.app), 19) <>
        String.pad_leading(to_string(length(a.modules)), 7) <>
        String.pad_leading(to_string(length(a.loaded)), 9) <>
        String.pad_leading(to_string(length(a.not_loaded)), 13) <>
        String.pad_leading(to_string(a.matches), 12) <>
        String.pad_leading(to_string(length(a.diffs)), 11) <>
        String.pad_leading(to_string(length(a.compare_errors)), 10)
    )
end)

IO.puts("")
IO.puts(
  "TOTALS: #{total_modules} modules, #{total_loaded} loaded, #{total_not_loaded} not loaded (NOT VERIFIED), " <>
    "#{total_matches} md5 matches, #{total_diffs} diffs, #{total_compare_errors} compare errors."
)
IO.puts(
  "⚠️  NOT LOADED modules have never run on the serve this process; they will load whatever is in _build at first call, which may or may not be what was deployed."
)
IO.puts("")

not_loaded_apps = for %{status: :not_loaded_on_serve, app: app} <- per_app, do: app

if not_loaded_apps != [] do
  IO.puts("NOT LOADED ON SERVE — 0 modules swept, NOT VERIFIED: #{Enum.map_join(not_loaded_apps, ", ", &to_string/1)}\n")
end

all_diffs = Enum.flat_map(ok_apps, fn a -> Enum.map(a.diffs, &{a.app, &1}) end)
all_compare_errors = Enum.flat_map(ok_apps, fn a -> Enum.map(a.compare_errors, &{a.app, &1}) end)

if all_diffs != [] do
  IO.puts("MODULES WITH DIFFERING md5 (local vs remote) — up to 20 shown:")

  all_diffs
  |> Enum.take(20)
  |> Enum.each(fn {app, {:diff, mod, local, remote}} ->
    IO.puts("  [#{app}] #{inspect(mod)}")
    IO.puts("    local  md5: #{Base.encode16(local, case: :lower)}")
    IO.puts("    remote md5: #{Base.encode16(remote, case: :lower)}")
  end)

  extra = length(all_diffs) - 20
  if extra > 0, do: IO.puts("  … and #{extra} more")
  IO.puts("")
end

if all_compare_errors != [] do
  IO.puts("MODULES WHERE THE COMPARISON ITSELF ERRORED — up to 20 shown (not counted as matches OR diffs):")

  all_compare_errors
  |> Enum.take(20)
  |> Enum.each(fn {app, {:compare_error, mod, reason}} ->
    IO.puts("  [#{app}] #{inspect(mod)} — #{inspect(reason)}")
  end)

  extra = length(all_compare_errors) - 20
  if extra > 0, do: IO.puts("  … and #{extra} more")
  IO.puts("")
end

# --- named modules, resolved across ALL swept apps ------------------------
if named_modules != [] do
  IO.puts("NAMED MODULES (from argv):")

  Enum.each(named_modules, fn mod ->
    owner = Enum.find(ok_apps, fn a -> mod in a.modules end)

    cond do
      owner == nil ->
        IO.puts(
          "  #{inspect(mod)} — NOT a module of ANY swept app (swept: #{Enum.map_join(swept_apps, ", ", &to_string/1)})"
        )

      mod in owner.not_loaded ->
        IO.puts(
          "  #{inspect(mod)} — [#{owner.app}] MODULE NOT LOADED — the serve is not running this code; it will load from _build when first called. NOT a match, NOT a diff — not verified."
        )

      true ->
        case compare.(mod) do
          {:match, _} ->
            IO.puts("  #{inspect(mod)} — [#{owner.app}] LOADED, md5 MATCHES local disk.")

          {:diff, _, local, remote} ->
            IO.puts(
              "  #{inspect(mod)} — [#{owner.app}] LOADED, md5 DIFFERS: local #{Base.encode16(local, case: :lower)} vs remote #{Base.encode16(remote, case: :lower)}"
            )

          {:compare_error, _, reason} ->
            IO.puts("  #{inspect(mod)} — [#{owner.app}] LOADED, but comparison errored: #{inspect(reason)}")
        end
    end
  end)

  IO.puts("")
end

# --- verdict ---------------------------------------------------------------
IO.puts(
  "cp-verify-deploy: verified #{total_matches} of #{total_modules} modules across #{length(ok_apps)} app(s) " <>
    "(#{total_not_loaded} never loaded — NOT verified" <>
    (if total_diffs > 0 or total_compare_errors > 0,
       do: "; #{total_diffs} md5 diff(s), #{total_compare_errors} compare error(s) among the loaded set",
       else: "") <>
    (if not_loaded_apps != [], do: "; #{length(not_loaded_apps)} app(s) not loaded on serve at all", else: "") <>
    ")."
)

System.halt(0)
ELIXIR

# Pin-aware (2026-08-21 pinned-boot migration): local md5s must come from
# the tree the serve actually boots — the pin worktree when a valid one
# exists. Comparing resident modules against the SHARED tree post-migration
# reports skew that is about the wrong tree. CP_VERIFY_TREE overrides
# explicitly (demonstrations); else a valid pin wins; else legacy.
PIN_DIR=/home/jes/commonplace-serve-pin
if [ -n "${CP_VERIFY_TREE:-}" ]; then
  RUN_TREE="$CP_VERIFY_TREE"
  echo "local-beam tree: CP_VERIFY_TREE override -> $RUN_TREE"
elif "$SCRIPT_DIR/cp-pin-status" --quick >/dev/null 2>&1; then
  RUN_TREE="$PIN_DIR"
  echo "local-beam tree: pin worktree $PIN_DIR"
else
  RUN_TREE="$PROJECT_DIR"
  echo "local-beam tree: shared tree (no valid pin)"
fi
cd "$RUN_TREE"
CP_VERIFY_DEPLOY_HOST="$SERVE_HOST" CP_VERIFY_DEPLOY_APPS="$UMBRELLA_APPS" ERL_INETRC="$INETRC" mix run --no-start "$PROBE_SCRIPT" -- "$SERVE_NODE" "$@"
