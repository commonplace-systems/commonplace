#!/usr/bin/env bash
#
# cp-deploy-gap — how much would a serve restart deploy?
#
# WHY THIS EXISTS (CX-y4bq, 2026-08-09)
#
# The serve loads modules LAZILY in :interactive mode. Any beam in _build that
# is NEWER than the running serve's start is code the serve was not built with
# and will hot-load the moment something touches it. So:
#
#   - a restart deploys every one of them, at once
#   - and until then, ANY incidental module load is an unplanned partial deploy
#
# Measured 2026-08-09: 52 such beams, accumulated by an ordinary session's
# merges. Nobody could see the number, which was the whole problem.
#
# ⛔ WHAT THIS ANSWERS, AND WHAT IT DOES NOT
#
#   ✅ "What would a restart CHANGE?"     — beam mtime vs serve start. THIS.
#   ⛔ "Is _build a COHERENT version?"    — NOT ANSWERABLE HERE.
#
# _build legitimately holds beams from months ago: an April beam is CORRECT if
# its source has not changed since April. A reassuring age distribution is not
# evidence of coherence. The only thing that answers coherence is `mix compile`
# reporting "Compiling 0 files" — and running it is a WRITE that MOVES THE
# DEPLOY BOUNDARY, so it is a deliberate step, never a measurement.
#
# ⚠️ Do not relabel this as a coherence check. A gauge mislabelled is worse
#    than no gauge: it converts "I did not look" into "I looked and it was fine".
#
# ⭐ THE DISCRIMINATOR THIS EXISTS TO MAKE CHEAP:
#      beam OLDER than the serve's start -> the file the serve would load
#                                            anyway; loading it is NOT a deploy
#      beam NEWER than the serve's start -> loading it IS a deploy
#
# USAGE
#   bin/cp-deploy-gap                 # against the running serve
#   bin/cp-deploy-gap --since <time>  # against an explicit reference time
#   bin/cp-deploy-gap --assert-empty [--since <time>]
#   CP_BUILD_DIR=... bin/cp-deploy-gap --since <time>   # for testing the gauge
#   CP_SERVE_PORT=... bin/cp-deploy-gap                 # serve's listen port (default 5199)

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# Pin-aware (2026-08-21 pinned-boot migration): the serve boots from the
# pin worktree, so ITS _build is the one whose beams-newer-than-boot means
# anything. Reading the shared tree post-migration is the cp-resolve-beam
# class: a gauge pointed at where the serve USED to live. Explicit
# CP_BUILD_DIR still wins (tests); otherwise a VALID pin (cp-pin-status
# --quick) selects the pin tree; else the legacy relative path.
PIN_DIR=/home/jes/commonplace-serve-pin
if [ -n "${CP_BUILD_DIR:-}" ]; then
  BUILD_DIR="$CP_BUILD_DIR"
  TREE_NOTE="CP_BUILD_DIR override"
elif "$(dirname "$0")/cp-pin-status" --quick >/dev/null 2>&1; then
  BUILD_DIR="$PIN_DIR/_build/dev/lib"
  TREE_NOTE="pin worktree $PIN_DIR"
else
  BUILD_DIR="_build/dev/lib"
  TREE_NOTE="shared tree (no valid pin)"
fi
echo "reading beams from: $TREE_NOTE"
SINCE=""
ASSERT_EMPTY=0

if [[ "${1:-}" == "--assert-empty" ]]; then
  ASSERT_EMPTY=1
  shift
fi

if [[ "${1:-}" == "--since" ]]; then
  SINCE="${2:?--since needs a timestamp}"
else
  # Process-derived, never assumed: find the serve by a HANDLE IT OWNS — the
  # process holding the serve's LISTENING SOCKET (:5199 by default) — and take
  # THAT process's start as the deploy reference.
  #
  # ⭐ WHY A SOCKET, NOT A CMDLINE (candidate 2, 2026-08-21). The prior version
  # matched `pgrep -f 'commonplace_dev'` over beam.smp cmdlines. A command line
  # is not an identity: any process that merely NAMES the node on its argv — a
  # `mix run --no-start` probe passing the target node as an argument — matched
  # the pattern, and the deploy-gap monitor fired on the probe, the single
  # largest error category the serve ever logged and the noise real audit
  # signals hide in. That happened: `bin/state-render` passed the node on argv
  # (fixed caller-side @8d534e62). THIS is the bound-safe root: a listening
  # socket is a handle the OS grants to exactly one process, and a `--no-start`
  # probe can never hold it — the fix cannot be defeated by a new caller. Third
  # argv-as-identity instance on this host (see also the 2026-08-10 phx.server
  # kill of hermes' BEAM, and `--unit` scoping); "a command line is not an
  # identity." The old comm==beam.smp filter is not restored: gating on a comm
  # STRING would reintroduce the weaker cousin of the very match we remove, and
  # single-opener socket ownership already implies the one serve (comm is
  # REPORTED below for a human cross-check, not gated on).
  #
  # ⚠️ If we cannot identify it, REFUSE — a gauge that reports 0 because it
  #    could not find the subject is the exact false green this repo keeps
  #    producing.
  # ⚠️ Do NOT 2>/dev/null the ss call. "ss failed / not permitted to see pids"
  #    and "nothing listens" must not collapse into one empty result: the first
  #    is an undefined measurement, the second a real absence. Both REFUSE, but
  #    for stated and different reasons. Same discipline as the beam scan below.
  port="${CP_SERVE_PORT:-5199}"
  ss_out="$(ss -ltnp 2>&1)"
  ss_status=$?
  if [[ $ss_status -ne 0 ]]; then
    echo "cp-deploy-gap: REFUSING — could not list listening sockets (ss exit $ss_status)." >&2
    echo "  Serve identity is undefined without it; a count against no subject is not zero." >&2
    echo "  ss: $ss_out" >&2
    exit 2
  fi

  # One pid per line for the row(s) whose Local Address:Port ends in :$port.
  # Match the port as the LAST colon-separated field of the local address so
  # :5199 never matches :51990 or a peer/foreign port; dedup because a serve
  # bound on both IPv4 and IPv6 shows the SAME pid on two rows.
  mapfile -t pids < <(printf '%s\n' "$ss_out" | awk -v port="$port" '
    $1 == "LISTEN" {
      n = split($4, a, ":")
      if (a[n] == port && match($0, /pid=[0-9]+/)) print substr($0, RSTART + 4, RLENGTH - 4)
    }' | sort -u)

  if [[ "${#pids[@]}" -eq 0 ]]; then
    echo "cp-deploy-gap: REFUSING — no process is listening on :$port." >&2
    echo "  The serve is identified by the socket it owns; without it there is no" >&2
    echo "  subject, and a count against no subject is not zero, it is undefined." >&2
    echo "  (If ss showed the socket but omitted the pid column, re-run with" >&2
    echo "   permission to read it — a hidden pid is not an absent serve.)" >&2
    echo "  Use --since <timestamp> if you meant a reference time." >&2
    exit 2
  fi

  if [[ "${#pids[@]}" -gt 1 ]]; then
    echo "cp-deploy-gap: REFUSING — ${#pids[@]} distinct processes listen on :$port (${pids[*]})." >&2
    echo "  Ambiguous serve identity — refusing rather than picking one arbitrarily." >&2
    exit 2
  fi

  pid="${pids[0]}"
  comm="$(cat "/proc/$pid/comm" 2>/dev/null || echo '?')"

  SINCE="$(ps -o lstart= -p "$pid" | sed 's/^ *//')"
  if [[ -z "$SINCE" ]]; then
    echo "cp-deploy-gap: REFUSING — pid $pid holds :$port but has no start time (gone between ss and ps?)." >&2
    exit 2
  fi
  # State the METHOD in the output. A tool's number arrives without its
  # provenance: when a person tells you something you ask how they know, and
  # when a gauge prints a pid the question does not occur to anyone. Name the
  # handle (the socket), the pid, and its comm so a human can cross-check.
  echo "serve pid $pid, started $SINCE"
  echo "  (identified by: holds the :$port listening socket — ss -ltnp; comm=$comm)"
fi

[[ -d "$BUILD_DIR" ]] || { echo "cp-deploy-gap: no $BUILD_DIR" >&2; exit 2; }

# Capture find's status; do NOT 2>/dev/null it. A failed scan (unreadable dir,
# a $SINCE that -newermt cannot parse, a transient FS error) must not read as an
# EMPTY gap: with 2>/dev/null the list came back empty, total=0, and the gauge
# reported "no gap" with exit 0 — a broken measurement byte-identical to a clean
# all-clear. Under the DeployGapMonitor ledger that spurious 0 is a false CLEARED
# transition that closes the open row (a false clear is worse than a false open).
# Same reasoning as the no-serve REFUSAL above ("a count against no subject is
# not zero, it is undefined"), applied to a failing SCAN, not just a missing
# serve. (commonplace-coder #14102.)
find_out="$(find "$BUILD_DIR" -name '*.beam' -newermt "$SINCE" 2>&1)"
find_status=$?
if [[ $find_status -ne 0 ]]; then
  echo "cp-deploy-gap: REFUSING — beam scan failed (find exit $find_status)." >&2
  echo "  A count from a failed scan is not zero, it is undefined." >&2
  echo "  find: $find_out" >&2
  exit 2
fi
mapfile -t newer_beams < <(printf '%s' "$find_out" | sed '/^[[:space:]]*$/d' | sort)
total="${#newer_beams[@]}"

echo "WOULD-DEPLOY-ON-RESTART: $total beam(s) newer than that start"
echo "  (this is NOT a coherence check — see the header)"

if (( total > 0 )); then
  echo "  newer beams:"
  printf '    %s\n' "${newer_beams[@]}"
  echo
  echo "  by app:"
  printf '%s\n' "${newer_beams[@]}" \
    | sed "s|^$BUILD_DIR/\([^/]*\)/.*|\1|" | uniq -c | sort -rn \
    | sed 's/^/    /'
  echo
  echo "  ⇒ A restart deploys all of these AT ONCE."
  echo "  ⇒ Until then, any incidental load of one is an unplanned partial deploy."
  echo "  ⇒ Run 'mix compile' DELIBERATELY before restarting, so what ships"
  echo "    corresponds to a commit rather than to whatever happens to be built."
fi

if (( ASSERT_EMPTY == 1 && total > 0 )); then
  echo "cp-deploy-gap: ASSERTION FAILED — $total beam(s) are newer than the running process start." >&2
  exit 1
fi

exit 0
