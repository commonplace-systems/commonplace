#!/usr/bin/env bash
#
# cp-deploy-gap — how much would a serve restart deploy?
#
# WHY THIS EXISTS (CX-y4bq, 2026-08-09)
#
# The serve loads modules LAZILY in :interactive mode. Any beam in _build that
# is NEWER than the running serve's start is code the serve was not built with
# and will hot-load the moment something touches it. So:
#
#   - a restart deploys every one of them, at once
#   - and until then, ANY incidental module load is an unplanned partial deploy
#
# Measured 2026-08-09: 52 such beams, accumulated by an ordinary session's
# merges. Nobody could see the number, which was the whole problem.
#
# ⛔ WHAT THIS ANSWERS, AND WHAT IT DOES NOT
#
#   ✅ "What would a restart CHANGE?"     — beam mtime vs serve start. THIS.
#   ⛔ "Is _build a COHERENT version?"    — NOT ANSWERABLE HERE.
#
# _build legitimately holds beams from months ago: an April beam is CORRECT if
# its source has not changed since April. A reassuring age distribution is not
# evidence of coherence. The only thing that answers coherence is `mix compile`
# reporting "Compiling 0 files" — and running it is a WRITE that MOVES THE
# DEPLOY BOUNDARY, so it is a deliberate step, never a measurement.
#
# ⚠️ Do not relabel this as a coherence check. A gauge mislabelled is worse
#    than no gauge: it converts "I did not look" into "I looked and it was fine".
#
# ⭐ THE DISCRIMINATOR THIS EXISTS TO MAKE CHEAP:
#      beam OLDER than the serve's start -> the file the serve would load
#                                            anyway; loading it is NOT a deploy
#      beam NEWER than the serve's start -> loading it IS a deploy
#
# USAGE
#   bin/cp-deploy-gap                 # against the running serve
#   bin/cp-deploy-gap --since <time>  # against an explicit reference time
#   bin/cp-deploy-gap --assert-empty [--since <time>]
#   CP_BUILD_DIR=... bin/cp-deploy-gap --since <time>   # for testing the gauge

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

BUILD_DIR="${CP_BUILD_DIR:-_build/dev/lib}"
SINCE=""
ASSERT_EMPTY=0

if [[ "${1:-}" == "--assert-empty" ]]; then
  ASSERT_EMPTY=1
  shift
fi

if [[ "${1:-}" == "--since" ]]; then
  SINCE="${2:?--since needs a timestamp}"
else
  # Process-derived, never assumed: find the serve by its OWN start time.
  # ⚠️ If we cannot identify it, REFUSE — a gauge that reports 0 because it
  #    could not find the subject is the exact false green this repo keeps
  #    producing.
  # ⚠️ MUST filter on comm == beam.smp. `elixir -S mix phx.server` runs a
  # wrapper process whose cmdline also contains commonplace_dev, and it exists
  # only for the first seconds after launch. Measured 2026-08-09: this tool
  # reported pid 2135710 (the wrapper, already gone) while the serve was
  # 2135767 — a transient sampled and printed as fact, by the tool built to be
  # authoritative about deploy state.
  pid="$(pgrep -f 'commonplace_dev' | while read -r p; do
           [ "$(cat "/proc/$p/comm" 2>/dev/null)" = beam.smp ] || continue
           if tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | grep -q 'commonplace_dev'; then
             echo "$p"; break
           fi
         done)"

  if [[ -z "$pid" ]]; then
    echo "cp-deploy-gap: REFUSING — no running commonplace serve found." >&2
    echo "  A count against no subject is not zero, it is undefined." >&2
    echo "  Use --since <timestamp> if you meant a reference time." >&2
    exit 2
  fi

  SINCE="$(ps -o lstart= -p "$pid" | sed 's/^ *//')"
  # State the METHOD in the output. A tool's number arrives without its
  # provenance: when a person tells you something you ask how they know, and
  # when a gauge prints a pid the question does not occur to anyone. This one
  # printed a transient wrapper pid once and it was relayed onward untouched.
  echo "serve pid $pid, started $SINCE"
  echo "  (identified by: comm==beam.smp AND cmdline contains commonplace_dev;"
  echo "   cross-check with: ss -ltnp | grep :5199)"
fi

[[ -d "$BUILD_DIR" ]] || { echo "cp-deploy-gap: no $BUILD_DIR" >&2; exit 2; }

# Capture find's status; do NOT 2>/dev/null it. A failed scan (unreadable dir,
# a $SINCE that -newermt cannot parse, a transient FS error) must not read as an
# EMPTY gap: with 2>/dev/null the list came back empty, total=0, and the gauge
# reported "no gap" with exit 0 — a broken measurement byte-identical to a clean
# all-clear. Under the DeployGapMonitor ledger that spurious 0 is a false CLEARED
# transition that closes the open row (a false clear is worse than a false open).
# Same reasoning as the no-serve REFUSAL above ("a count against no subject is
# not zero, it is undefined"), applied to a failing SCAN, not just a missing
# serve. (commonplace-coder #14102.)
find_out="$(find "$BUILD_DIR" -name '*.beam' -newermt "$SINCE" 2>&1)"
find_status=$?
if [[ $find_status -ne 0 ]]; then
  echo "cp-deploy-gap: REFUSING — beam scan failed (find exit $find_status)." >&2
  echo "  A count from a failed scan is not zero, it is undefined." >&2
  echo "  find: $find_out" >&2
  exit 2
fi
mapfile -t newer_beams < <(printf '%s' "$find_out" | sed '/^[[:space:]]*$/d' | sort)
total="${#newer_beams[@]}"

echo "WOULD-DEPLOY-ON-RESTART: $total beam(s) newer than that start"
echo "  (this is NOT a coherence check — see the header)"

if (( total > 0 )); then
  echo "  newer beams:"
  printf '    %s\n' "${newer_beams[@]}"
  echo
  echo "  by app:"
  printf '%s\n' "${newer_beams[@]}" \
    | sed "s|^$BUILD_DIR/\([^/]*\)/.*|\1|" | uniq -c | sort -rn \
    | sed 's/^/    /'
  echo
  echo "  ⇒ A restart deploys all of these AT ONCE."
  echo "  ⇒ Until then, any incidental load of one is an unplanned partial deploy."
  echo "  ⇒ Run 'mix compile' DELIBERATELY before restarting, so what ships"
  echo "    corresponds to a commit rather than to whatever happens to be built."
fi

if (( ASSERT_EMPTY == 1 && total > 0 )); then
  echo "cp-deploy-gap: ASSERTION FAILED — $total beam(s) are newer than the running process start." >&2
  exit 1
fi

exit 0
