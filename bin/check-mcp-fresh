#!/usr/bin/env bash
#
# check-mcp-fresh — fail loudly if the MCP escript is stale against the
# current build.
#
# WHY THIS EXISTS (CX-o9kj)
#
# The MCP escript is a precompiled binary bundling its own copies of the
# `commonplace` and `yelixer` apps (plus their deps). A deploy that
# recompiles the tree but forgets `bin/rebuild-mcp` leaves the escript
# running old code against a fresh serve — silently. That has burned
# hours: three separate observed "bugs" turned out to be the stale
# binary.
#
# `bin/rebuild-mcp` already existed, and its own header warns about
# exactly this trap. It was still skipped during deploy #28, by someone
# who had read that header the same evening. The reason is worth stating,
# because it generalises: every OTHER step of that deploy had a
# verifiable output — assert the sname, confirm the pid changed, poll for
# HTTP 200 — and this one had none. A step with no check attached is the
# one that evaporates under load. So this script attaches a check.
#
# COVERAGE IS DERIVED, NOT HARDCODED (CX-o1b9)
#
# This script used to check a hardcoded list of 9 "probe" modules whose
# skew had actually caused incidents, and reported success as
# "escript is FRESH (9 probe modules match _build)". During deploy #29
# (2026-08-05) a change to Commonplace.Store.Namespace — a real module,
# just not on the list — left the escript genuinely stale, and the
# script reported FRESH anyway. A sampled check reported in the language
# of a complete check is worse than no check at all: an operator reading
# "FRESH" now holds positive evidence for a false belief.
#
# So the probe list is gone. Instead:
#   (1) every module the escript actually carries (for apps it bundles
#       from this tree) is compared by md5 against _build.
#   (2) every module _build has, for an app the escript already bundles,
#       that is ABSENT from the escript entirely is also flagged — that
#       catches a brand-new module that was never bundled in the first
#       place, which a per-module diff alone would miss.
#
# Apps the escript bundles from the Erlang/Elixir runtime itself (elixir,
# logger, etc.) have no corresponding directory under _build/dev/lib —
# they come from the OTP install, not this tree — so they are skipped
# entirely rather than reported as "missing from build" noise.
#
# Usage:
#   bin/check-mcp-fresh          # exit 0 fresh, exit 1 stale, exit 2 could-not-verify
#
# Test overrides leave the tracked artifact and build untouched:
#   MCP_CHECK_ESCRIPT=/path/to/escript bin/check-mcp-fresh
#   MCP_CHECK_BUILD_DIR=/path/to/_build/dev/lib bin/check-mcp-fresh
#
# Intended as a deploy gate:
#   bin/check-mcp-fresh || bin/rebuild-mcp
#
# See also `Commonplace.VersionHandshake`, which makes the same skew
# visible at MCP session start. This script catches it earlier — at
# deploy time, when it is still cheap to fix.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
ESCRIPT="${MCP_CHECK_ESCRIPT:-$PROJECT_DIR/apps/commonplace_mcp/commonplace_mcp}"
BUILD="${MCP_CHECK_BUILD_DIR:-${MIX_BUILD_PATH:-$PROJECT_DIR/_build/dev}/lib}"

cannot_verify() {
  echo "check-mcp-fresh: CANNOT VERIFY — $1" >&2
  echo "check-mcp-fresh: coverage: 0 modules compared" >&2
  exit 2
}

[[ -f "$ESCRIPT" ]] || cannot_verify "no MCP escript at $ESCRIPT"
[[ -r "$ESCRIPT" ]] || cannot_verify "MCP escript is unreadable at $ESCRIPT"
[[ -d "$BUILD" ]] || cannot_verify "no build library directory at $BUILD"
[[ -r "$BUILD" ]] || cannot_verify "build library directory is unreadable at $BUILD"

cd "$PROJECT_DIR" || cannot_verify "cannot enter project directory at $PROJECT_DIR"

elixir -e '
[escript, build, project] = System.argv()

halt_cannot = fn detail, compared ->
  IO.puts(:stderr, "check-mcp-fresh: CANNOT VERIFY — #{detail}")
  IO.puts(:stderr, "check-mcp-fresh: coverage: #{compared} modules compared")
  System.halt(12)
end

# An escript is NOT a plain zip: it carries a header before the archive,
# so :zip.zip_open on the file fails with :bad_central_directory.
# :escript.extract/2 hands back the archive section as a binary.
result =
  try do
    with {:ok, sections} <- :escript.extract(String.to_charlist(escript), []),
         {:ok, archive} <- Keyword.fetch(sections, :archive),
         {:ok, entries} <- :zip.extract(archive, [:memory]) do
      {:ok, entries}
    else
      error -> {:error, inspect(error)}
    end
  rescue
    error -> {:error, Exception.message(error)}
  catch
    kind, value -> {:error, "#{kind}: #{inspect(value)}"}
  end

entries =
  case result do
    {:ok, extracted} -> extracted
    {:error, detail} -> halt_cannot.("cannot read MCP escript archive (#{detail})", 0)
  end

# :beam_lib.md5/1 takes the beam BINARY directly. Wrapping it as
# {:binary, bin} silently fails for every input — which made this script
# compare :unreadable against :unreadable and report FRESH unconditionally.
# It was caught only by insisting on a positive control before shipping.
md5_of = fn bin ->
  case :beam_lib.md5(bin) do
    {:ok, {_m, md5}} -> {:ok, md5}
    other -> {:error, inspect(other)}
  end
end

beam_re = ~r{^([^/]+)/ebin/([^/]+)\.beam$}

# app => %{module_name => beam_binary}
escript_by_app =
  entries
  |> Enum.reduce(%{}, fn {name, bin}, acc ->
    case Regex.run(beam_re, to_string(name)) do
      [_, app, mod] -> Map.update(acc, app, %{mod => bin}, &Map.put(&1, mod, bin))
      nil -> acc
    end
  end)

# Identify project apps from the tree, then restrict the comparison to the
# project apps actually bundled in this escript. Runtime apps are excluded by
# identity, rather than inferred from whether the build happens to be complete.
project_apps =
  project
  |> Path.join("apps/*/mix.exs")
  |> Path.wildcard()
  |> Enum.map(fn mix_file -> mix_file |> Path.dirname() |> Path.basename() end)
  |> MapSet.new()

bundled_project_apps =
  escript_by_app
  |> Map.keys()
  |> Enum.filter(&MapSet.member?(project_apps, &1))
  |> Enum.sort()

if bundled_project_apps == [] do
  halt_cannot.("MCP escript contains no project apps, so freshness is underivable", 0)
end

missing_build_apps =
  Enum.reject(bundled_project_apps, fn app -> File.dir?(Path.join([build, app, "ebin"])) end)

if missing_build_apps != [] do
  halt_cannot.(
    "build is incomplete for #{length(missing_build_apps)} bundled project app(s): " <>
      Enum.join(missing_build_apps, ", "),
    0
  )
end

# Protocols are consolidated at build time: mix.build rewrites the
# protocol module to embed its known implementations, and the ESCRIPT
# bundles that consolidated copy, not the raw per-app ebin/ one. Compiling
# an escript against a subset of apps (deps not bundled) or a full build
# against the whole umbrella can consolidate the very same protocol into
# genuinely different, still-correct bytecode. Comparing against the raw
# lib/ebin copy for those modules is comparing the wrong reference and
# manufactures false STALE reports (caught live: Elixir.CubDB.Store and
# Elixir.Jason.Encoder differed from _build/dev/lib but matched
# _build/dev/consolidated exactly). Prefer the consolidated copy — the one
# actually shipped in this build — when one exists for that module.
consolidated_dir = Path.join(Path.dirname(build), "consolidated")

reference_for = fn app, mod ->
  consolidated_path = Path.join(consolidated_dir, "#{mod}.beam")
  built_path = Path.join([build, app, "ebin", "#{mod}.beam"])

  cond do
    File.regular?(consolidated_path) -> {consolidated_path, File.read(consolidated_path)}
    File.regular?(built_path) -> {built_path, File.read(built_path)}
    true -> {built_path, {:error, :enoent}}
  end
end

# --- (1) compare every module the escript carries, for in-tree apps ---
compared =
  for app <- bundled_project_apps, {mod, bin} <- Map.fetch!(escript_by_app, app) do
    {reference_path, reference_read} = reference_for.(app, mod)
    escript_md5 = md5_of.(bin)

    build_md5 =
      case reference_read do
        {:ok, binary} -> md5_of.(binary)
        {:error, :enoent} -> :missing
        {:error, reason} -> {:error, inspect(reason)}
      end

    {app, mod, escript_md5, build_md5, reference_path}
  end

if compared == [] do
  halt_cannot.("MCP escript yielded zero comparable project modules", 0)
end

unreadable =
  Enum.filter(compared, fn {_app, _module, escript_md5, build_md5, _path} ->
    match?({:error, _}, escript_md5) or match?({:error, _}, build_md5)
  end)

if unreadable != [] do
  IO.puts(:stderr, "check-mcp-fresh: CANNOT VERIFY — #{length(unreadable)} module(s) unreadable")

  Enum.each(unreadable, fn {app, mod, escript_md5, build_md5, path} ->
    IO.puts(
      :stderr,
      "      #{app}/#{mod} escript=#{inspect(escript_md5)} build=#{inspect(build_md5)} path=#{path}"
    )
  end)

  IO.puts(:stderr, "check-mcp-fresh: coverage: #{length(compared)} modules compared")
  System.halt(12)
end

changed =
  compared
  |> Enum.filter(fn {_a, _m, e, b, _path} -> e != b end)
  |> Enum.map(fn {a, m, e, b, _path} -> {a, m, :changed, e, b} end)

# --- (2) modules _build has, for an in-tree bundled app, that the ---
# --- escript never bundled at all (brand-new module, never rebuilt) ---
missing_from_escript =
  Enum.flat_map(bundled_project_apps, fn app ->
    ebin_dir = Path.join([build, app, "ebin"])

    files =
      case File.ls(ebin_dir) do
        {:ok, entries} -> entries
        {:error, reason} ->
          halt_cannot.(
            "cannot list build modules for #{app} at #{ebin_dir} (#{inspect(reason)})",
            length(compared)
          )
      end

    for file <- files,
        String.ends_with?(file, ".beam"),
        mod = String.trim_trailing(file, ".beam"),
        not Map.has_key?(Map.fetch!(escript_by_app, app), mod) do
      {app, mod, :missing_from_escript, :missing, :"(in _build)"}
    end
  end)

stale = changed ++ missing_from_escript

n_modules = length(compared)
n_apps = length(bundled_project_apps)

if stale == [] do
  IO.puts("check-mcp-fresh: escript is FRESH — #{n_modules} modules across #{n_apps} apps match the build")
  IO.puts("check-mcp-fresh: coverage: #{n_modules} modules compared; 0 stale; 0 missing from escript")
  System.halt(0)
else
  IO.puts(:stderr, """

  ⚠️  MCP ESCRIPT IS STALE — #{length(stale)} module(s) differ from _build (out of #{n_modules} compared + #{length(missing_from_escript)} checked for bundling, across #{n_apps} apps).

  The escript is a precompiled binary; it does not pick up code changes
  until it is rebuilt. A session started now would run old code against
  the deployed serve.
  """)

  fmt = fn
    {:ok, md5} -> Base.encode16(md5, case: :lower) |> String.slice(0, 12)
    {:error, _reason} -> "unreadable"
    :missing -> "missing"
    :"(in _build)" -> "(in _build)"
  end

  stale
  |> Enum.sort_by(fn {a, m, _reason, _e, _b} -> {a, m} end)
  |> Enum.take(20)
  |> Enum.each(fn {a, m, reason, e, b} ->
    reason_str = if reason == :changed, do: "changed", else: "missing from escript"
    IO.puts(:stderr, "      #{String.pad_trailing("#{a}/#{m}", 60)} #{reason_str} (escript=#{fmt.(e)} build=#{fmt.(b)})")
  end)

  if length(stale) > 20 do
    IO.puts(:stderr, "      … and #{length(stale) - 20} more")
  end

  IO.puts(:stderr, "\n  Fix: bin/rebuild-mcp\n")
  IO.puts(:stderr, "check-mcp-fresh: coverage: #{n_modules} modules compared; #{length(stale)} stale")
  System.halt(11)
end
' "$ESCRIPT" "$BUILD" "$PROJECT_DIR"

rc=$?
case "$rc" in
  0) exit 0 ;;
  11) exit 1 ;;
  12) exit 2 ;;
esac

echo "check-mcp-fresh: CANNOT VERIFY — checker runtime exited unexpectedly with status $rc" >&2
echo "check-mcp-fresh: coverage: 0 modules compared" >&2
exit 2
