{"actor":"Jes Wolfe!","comment":null,"created_at":"2026-03-22T17:00:10Z","event_type":"status_changed","id":71,"issue_id":"CX-hgv","new_value":"{\"status\":\"in_progress\"}","old_value":"{\"id\":\"CX-hgv\",\"title\":\"Hot code reload for .exs processes\",\"description\":\"When a process's .exs source document changes in the CRDT, the orchestrator should recompile and hot-swap the running process. The orchestrator already detects source changes — needs to use Code.purge_module + Code.compile_string for seamless hot reload without restart.\",\"status\":\"open\",\"priority\":1,\"issue_type\":\"task\",\"owner\":\"jes5199@gmail.com\",\"created_at\":\"2026-03-22T16:17:24Z\",\"created_by\":\"Jes Wolfe!\",\"updated_at\":\"2026-03-22T16:17:24Z\"}"}
{"actor":"Jes Wolfe!","comment":null,"created_at":"2026-03-22T17:00:10Z","event_type":"status_changed","id":72,"issue_id":"CX-bqz","new_value":"{\"status\":\"in_progress\"}","old_value":"{\"id\":\"CX-bqz\",\"title\":\"stdout/stderr capture to red event log\",\"description\":\"Orchestrator captures process stdout/stderr line-by-line and appends as red events: {type: 'stdout'/'stderr', line: '...', timestamp: '...'}. JSONL format per jes's IRC confirmation. Enables 'commonplace event tail worker.exe' for live process output.\",\"status\":\"open\",\"priority\":1,\"issue_type\":\"task\",\"owner\":\"jes5199@gmail.com\",\"created_at\":\"2026-03-22T16:15:29Z\",\"created_by\":\"Jes Wolfe!\",\"updated_at\":\"2026-03-22T16:15:29Z\"}"}
